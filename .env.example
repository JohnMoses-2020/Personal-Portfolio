# Copy to `.env.local` for local development, or `.env.production.local` so
# production builds (npm run build / npm run deploy) pick these up.
#
# All NEXT_PUBLIC_* variables are inlined at BUILD time. Changing them requires
# a rebuild (and a redeploy).

# Canonical site URL (no trailing slash). Used for metadata, Open Graph,
# sitemap.xml and robots.txt. `npm run deploy` sets this from SITE_URL.
NEXT_PUBLIC_SITE_URL=https://srv1727766.hstgr.cloud

# Contact & profile links shown in the navigation, About page and footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/

# Optional: path or URL of a downloadable résumé PDF. Leave empty to hide the
# download button. For a local file, put it in /public and reference it, e.g.
# NEXT_PUBLIC_RESUME_PDF_URL=/resume/john-moses-resume.pdf
NEXT_PUBLIC_RESUME_PDF_URL=

# ---- deploy/deploy.sh & deploy/rollback.sh (shell env, optional) ---------
# SITE_URL=https://srv1727766.hstgr.cloud
# DEPLOY_HOST=root@srv1727766.hstgr.cloud
# DEPLOY_ROOT=/var/www/portfolio
# KEEP_RELEASES=3

# ---- optional docker compose ---------------------------------------------
# Loopback host port the reverse proxy forwards to.
PORTFOLIO_HOST_PORT=3100
