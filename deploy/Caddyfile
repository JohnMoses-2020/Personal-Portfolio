# Caddyfile for the portfolio — installed to /etc/caddy/Caddyfile on the VPS.
# Source of truth: deploy/Caddyfile in the portfolio repo.
#
# Caddy serves the static export from /var/www/portfolio/current (a symlink to
# the active release) and manages HTTPS automatically (Let's Encrypt with
# ZeroSSL fallback, HTTP→HTTPS redirect, renewals).
#
# To move to a real domain later: replace the site address below, point an
# A (and optionally AAAA) record at this server, then `systemctl reload caddy`.

srv1727766.hstgr.cloud {
	root * /var/www/portfolio/current
	encode zstd gzip

	# Hashed build assets and generated image variants never change.
	@immutable path /_next/static/* /images/_opt/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else (HTML, sitemap, originals) revalidates via ETag.
	@mutable not path /_next/static/* /images/_opt/*
	header @mutable Cache-Control "public, max-age=0, must-revalidate"

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# /work/ → /work (the export uses extensionless clean URLs).
	@trailing path_regexp trail ^/(.+)/$
	redir @trailing /{re.trail.1} 308

	# Clean URLs: /work → /work.html
	try_files {path} {path}.html

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	file_server

	log {
		output file /var/log/caddy/portfolio-access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
