# Caddyfile used inside the optional Docker image (see Dockerfile).
# Serves the static export over plain HTTP on :80; terminate TLS at the
# reverse proxy in front of the container.
{
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	@immutable path /_next/static/* /images/_opt/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /_next/static/* /images/_opt/*
	header @mutable Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@trailing path_regexp trail ^/(.+)/$
	redir @trailing /{re.trail.1} 308
	try_files {path} {path}.html

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	file_server
}
